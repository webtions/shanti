# Handle line endings
* text=auto

# Binary files — avoid line-ending changes or diffs
*.gif  binary
*.ico  binary
*.jpg  binary
*.jpeg binary
*.png  binary
*.webp binary
*.svg  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.zip  binary

# Ignore dev/build files when generating GitHub ZIP exports
.deployignore           export-ignore
.gitattributes          export-ignore
.gitignore              export-ignore
.editorconfig           export-ignore
.prettierrc             export-ignore
.prettierignore         export-ignore
.eslintignore           export-ignore
phpcs.xml               export-ignore
phpcs.xml.dist          export-ignore
phpstan.neon.dist       export-ignore
phpci.yml               export-ignore
phpunit.xml             export-ignore
composer.json           export-ignore
composer.lock           export-ignore
package.json            text eol=lf export-ignore
package-lock.json       text eol=lf export-ignore
theme-utils.mjs         text eol=lf export-ignore
.nvmrc                  text eol=lf export-ignore
Gruntfile.js            export-ignore
.vscode/                export-ignore
.github/                export-ignore
README.md               export-ignore
SECURITY.md             export-ignore
/.wordpress-org/        export-ignore
/build/                 export-ignore
/_docs/                 export-ignore
/tests/                 export-ignore
